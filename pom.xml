<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    实验五：TaskMaster 的 SpringBoot 现代化与部署上线

    与实验四的差异（本次改造的核心）：
      1. 打包方式 war → **jar**。
         实验四之所以只能用 war，是因为 JSP 在可执行 jar 里跑不起来
         （Tomcat 对 jar 内 JSP 有硬编码路径限制）；本次改用 Thymeleaf，
         模板从 classpath 读取，因此终于可以打成可执行 jar，实现真正的一键部署。
      2. MyBatis → **MyBatis-Plus**（BaseMapper + 条件构造器 + 分页插件）
      3. 新增 **spring-boot-starter-validation**（@Valid 服务端校验）
      4. Thymeleaf 取代 JSP，因此移除 tomcat-embed-jasper 与 provided 的内嵌容器
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>cn.edu.mju.task</groupId>
  <artifactId>taskmaster-boot</artifactId>
  <version>1.1.0</version>
  <packaging>jar</packaging>
  <name>TaskMaster SpringBoot 现代化版</name>

  <properties>
    <java.version>8</java.version>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <mybatis.plus.version>3.5.3.2</mybatis.plus.version>
    <jacoco.version>0.8.11</jacoco.version>
  </properties>

  <dependencies>
    <!-- Web：MVC、内嵌 Tomcat、Jackson -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 环节二：Thymeleaf 模板引擎（取代 JSP）。
         Spring Boot 为它提供 starter，模板放在 classpath:/templates/ 下，
         因此可执行 jar 也能正常渲染 —— 这是能改打 jar 的前提。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>

    <!-- 环节四：Spring Validation（@Valid / @NotBlank / @Size / @Min / @Max） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- 环节三：MyBatis-Plus（BaseMapper + LambdaQueryWrapper + 分页插件） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-boot-starter</artifactId>
      <version>${mybatis.plus.version}</version>
    </dependency>

    <!-- MySQL 驱动（坐标与版本由 parent 管理） -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 测试：JUnit 5 + Mockito + AssertJ + Spring Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>taskmaster-plus</finalName>
    <plugins>
      <!-- 打成可执行 jar：java -jar target/taskmaster-plus.jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- 排除 lombok 之类无需打包的依赖可在此配置；本项目无 -->
        </configuration>
      </plugin>

      <!-- 覆盖率度量：mvn test 后生成 target/site/jacoco/index.html -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
